      "end": 4.98,
      "text": "John Mangles therefore hoped that the wretched hole would reach poor."
    },
    {
      "speaker": "Speaker 0",
      "start": 5.16,
      "end": 6.16,
      "text": "without accident."
    },
    {
      "speaker": "Speaker 0",
      "start": 6.78,
      "end": 7.94,
      "text": "but it grieved him."
    },
    {
      "speaker": "Speaker 0",
      "start": 8.19,
      "end": 10.19,
      "text": "that his companions."
    },
    {
      "speaker": "Speaker 0",
      "start": 9.6,
      "end": 10.6,
      "text": "should have to suffer."
    },
    {
      "speaker": "Speaker 0",
